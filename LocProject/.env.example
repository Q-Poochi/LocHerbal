# LocHerbal API — Template môi trường (.env.example)
# =============================================================================
# Có 2 nội dung quan trọng:
#   1) MẪU NÀY CHỈ KHAI BÁO TÊN BIẾN — ĐỂ TRỐNG GIÁ TRỊ.
#      KHÔNG BAO GIỜ điền giá trị thật, KHÔNG BAO GIỜ commit `.env` thật
#      vào repository.
#   2) Sinh lại đủ secret riêng cho TỪNG môi trường trước khi deploy
#      (dev), staging, production — KHÔNG dùng chung một JWT/VNPay hash.
# ============================================================================

# --- Database ------------------------------------------------------------
# DATABASE_URL = DSN của app tới Postgres (qua PgBouncer 6432 ở dev).
# DIRECT_URL  = DSN trực tiếp tới Primary (chỉ dùng cho Prisma migrate).
DATABASE_URL=
DIRECT_URL=

# --- JWT: bắt buộc sinh riêng, ví dụ `openssl rand -hex 64` ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- VNPay (sandbox lấy từ email activation; production dùng thông số thật) ---
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=
VNP_RETURN_URL=
VNP_IPN_URL=

# --- Redis (cache catalog/single-flight) ---
REDIS_HOST=
REDIS_PORT=

# --- App / Bảo mật ---
NODE_ENV=
PORT=
API_URL=
THROTTLE_LIMIT=
AUTH_THROTTLE_LIMIT=
# TrangSMS/ESMS thật khi lên production. Nếu NODE_ENV=production mà thiếu
# biến này, app KHÔNG khởi động được (chặn mock OTP lọt ra production).
SMS_PROVIDER_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=

# --- Hạ tầng cục bộ (docker-compose: Postgres + PgBouncer + MinIO) ---
# IMPORTANT: chỉ là biến hạ tầng dev, không phải thông tin kinh doanh;
# vẫn áp dụng nguyên tắc KHÔNG commit giá trị thật.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
PGPASSWORD=
PGBOUNCER_PORT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=